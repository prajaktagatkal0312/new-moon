pragma language_version >= 0.23;

import CompactStandardLibrary;

export ledger validCredentials: Map<Bytes<32>, Boolean>;
export ledger verifiedProofs: Map<Bytes<32>, Boolean>;

witness credential(): Bytes<32>;
witness credentialSalt(): Bytes<32>;
witness nullifierSalt(): Bytes<32>;

export circuit issueCredential(): [] {
    const cred = credential();
    const cSalt = credentialSalt();
    const commitment = persistentCommit<Bytes<32>>(cred, cSalt);
    
    // Anyone can issue for this demo.
    // DISCLOSE commitment hash only.
    validCredentials.insert(disclose(commitment), disclose(true));
}

export circuit revokeCredential(): [] {
    const cred = credential();
    const cSalt = credentialSalt();
    const commitment = persistentCommit<Bytes<32>>(cred, cSalt);
    
    assert(validCredentials.member(commitment), "Credential not found");
    
    // Revoke by setting to false
    validCredentials.insert(disclose(commitment), disclose(false));
}

export circuit proveCredentialValid(): [] {
    const cred = credential();
    const cSalt = credentialSalt();
    const nSalt = nullifierSalt();
    
    const commitment = persistentCommit<Bytes<32>>(cred, cSalt);
    
    // Check it exists and is true
    assert(validCredentials.member(commitment), "Credential is not registered");
    assert(validCredentials.lookup(commitment), "Credential is not valid or has been revoked");
    
    // Create a unique nullifier using a different salt
    const nullifier = persistentCommit<Bytes<32>>(cred, nSalt);
    assert(!verifiedProofs.member(nullifier), "Proof already submitted with this nullifier");
    
    // Record the proof without revealing the original commitment or the credential
    verifiedProofs.insert(disclose(nullifier), disclose(true));
}
