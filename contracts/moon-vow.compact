pragma language_version >= 0.23;

import CompactStandardLibrary;

// Public ledger state — visible on the Midnight blockchain
export ledger verifications: Map<Bytes<32>, Boolean>;

// Deploy-time fixed threshold


// Private witness declarations — resolved locally on client machine
witness privateValue(): Uint<32>;
witness salt(): Bytes<32>;

/**
 * Circuit: proveEligibility
 * Takes the user's private value as a witness, compares it to the threshold,
 * and commits the boolean result to public state if successful.
 */
export circuit proveEligibility(): [] {
    
    const THRESHOLD: Uint<32> = 18;
    const val = privateValue();
    const s = salt();
    
    // Check that the private value meets the threshold
    assert(val >= THRESHOLD, "Private value does not meet the eligibility threshold");
    
    // Compute a cryptographic commitment hash from private witness data
    // This acts as a unique, unlinkable nullifier for this verification
    const commitment = persistentCommit<Uint<32>>(val, s);
    
    // Require that the commitment is not already registered
    assert(!verifications.member(commitment), "This eligibility proof has already been submitted");
    
    // DISCLOSURE BOUNDARY:
    // `disclose(commitment)` reveals ONLY the 32-byte hash commitment to the public ledger map key.
    // The `privateValue` and `salt` remain strictly private on the user's machine.
    verifications.insert(disclose(commitment), disclose(true));
}

